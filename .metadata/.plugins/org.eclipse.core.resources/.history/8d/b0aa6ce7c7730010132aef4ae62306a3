package test_login_api;

import static org.testng.Assert.assertEquals;

import org.testng.annotations.AfterMethod;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.Test;

import com.aventstack.extentreports.ExtentReports;
import com.aventstack.extentreports.ExtentTest;
import com.aventstack.extentreports.Status;

import api.AuthClient;
import data.Data;
import io.restassured.response.Response;
import report.Report;
import utils.Messages;
import utils.MessagesLoginAPI;

public class LoginAPI {
	/*** VARIABLES ***/
	// Messages Login
	private final String LOGIN_API_TEST_START = MessagesLoginAPI.LOGIN_API_TEST_START.getMessage();
	private final String LOGIN_API = MessagesLoginAPI.LOGIN_API.getMessage(); 
	private final String LOGIN_API_COMPLETED = MessagesLoginAPI.LOGIN_API_COMPLETED.getMessage();
	private final String LOGIN_API_INCORRECT_COMPLETED = MessagesLoginAPI.LOGIN_API_INCORRECT_COMPLETED.getMessage();
	private final String VALIDATE_LOGIN_API = MessagesLoginAPI.VALIDATE_LOGIN_API.getMessage();
	private final String VALIDATE_LOGIN_API_INCORRECT = MessagesLoginAPI.VALIDATE_LOGIN_API_INCORRECT.getMessage();
	private final String LOGIN_API_TEST_OK = MessagesLoginAPI.LOGIN_API_TEST_OK.getMessage();
	private final String LOGIN_API_INCORRECT_TEST_OK = MessagesLoginAPI.LOGIN_API_INCORRECT_TEST_OK.getMessage();
	private final String LOGIN_API_TEST_ERROR = MessagesLoginAPI.LOGIN_API_TEST_ERROR.getMessage();
	private final String LOGIN_API_TEST_FINISH = MessagesLoginAPI.LOGIN_API_TEST_FINISH.getMessage();
		
	// Messages
	private final String USR_DOES_NOT_EXIST_API = Messages.USR_DOES_NOT_EXIST_API.getMessage();
	private final String WRONG_PASS_API = Messages.WRONG_PASS_API.getMessage();
	private final String LOGIN_API_OK = Messages.LOGIN_API_OK.getMessage();
	private final String CODE_MATCH = Messages.CODE_MATCH.getMessage();
	private final String CODE_MISMATCH = Messages.CODE_MISMATCH.getMessage();
	private final String RESPONSE_MATCH = Messages.RESPONSE_MATCH.getMessage();
	private final String RESPONSE_MISMATCH = Messages.RESPONSE_MISMATCH.getMessage();
	
	// Messages Assertion
	private final String HANDLE_ASSERTION_ERROR = Messages.HANDLE_ASSERTION_ERROR.getMessage();
	
	// Reports
	private ExtentReports report = null;

	/*** METHODS ***/
	// Test Pre-Config
	@BeforeMethod
	public void configurateTest() {
		report = Report.configurate();
		
	}
	
	// Testing Methods
	private void startTest(ExtentTest test, String usr) {
		test.log(Status.INFO, LOGIN_API_TEST_START + "\nUsuario: " + usr);
		System.out.println(LOGIN_API_TEST_START + "\nUsuario: " + usr + "\n");
		
	}
	
	private void finishTest(ExtentTest test, String usr) {
		test.log(Status.INFO, LOGIN_API_TEST_FINISH + "\nUsuario: " + usr);
		System.out.println(LOGIN_API_TEST_FINISH + "\nUsuario: " + usr + "\n");
		
	}
	
	private Response loginAPI(ExtentTest test, String usr, String pass, String msg, Response rs) {
		test.log(Status.INFO, LOGIN_API);	
		
		rs = AuthClient.login(usr, pass);
		
		test.log(Status.INFO, msg);
		
		return rs;
	}
	
	private void validateLoginAPI(ExtentTest test, String usr, String pass, Response response) {
		test.log(Status.INFO, VALIDATE_LOGIN_API);
		
        assertEquals(response.getStatusCode(), 200, CODE_MISMATCH);
        test.pass(CODE_MATCH);

        String rs = response.asPrettyString();
       
        assertEquals(rs, LOGIN_API_OK, RESPONSE_MISMATCH);
        test.pass(RESPONSE_MATCH);
		
		test.pass(LOGIN_API_TEST_OK);
		System.out.println(LOGIN_API_TEST_OK + "\nUsuario: " + usr + "\n");
		
	}
	
	private void validateLoginIncorrectAPI(ExtentTest test, String usr, String pass, String msg, Response response) {
		test.log(Status.INFO, VALIDATE_LOGIN_API_INCORRECT);
		
        assertEquals(response.getStatusCode(), 200, CODE_MISMATCH);
        test.pass(CODE_MATCH);

        String rs = response.asPrettyString();
        
        assertEquals(rs, msg, RESPONSE_MISMATCH);
        test.pass(RESPONSE_MATCH);
		
		test.pass(LOGIN_API_INCORRECT_TEST_OK);
		System.out.println(LOGIN_API_INCORRECT_TEST_OK + "\nUsuario: " + usr + "\n");
		
	}
	
	private void handleAssertionError(ExtentTest test, String usr, AssertionError e) {
		test.log(Status.INFO, HANDLE_ASSERTION_ERROR);
		
		test.addScreenCaptureFromPath("screenshot.png");
		
		test.fail(LOGIN_API_TEST_ERROR + "\nUsuario: " + usr + " \nERROR: " + e.getMessage());
		System.out.println(LOGIN_API_TEST_ERROR + "\nUsuario: " + usr + " \nERROR: " + e.getMessage() + "\n");
		
	}
	
	@Test(dataProvider = "LoginAPI", dataProviderClass = Data.class, priority = 1)
	public void loginAPIOK(String usr, String pass) {
		ExtentTest test = report.createTest("Login API Test");
		Response rs = null;
		
		startTest(test, usr);
		
		rs = loginAPI(test, usr, pass, LOGIN_API_COMPLETED, rs);
		
		try {
			validateLoginAPI(test, usr, pass, rs);
		}catch (AssertionError e) {
			handleAssertionError(test, usr, e);
		}finally {
			finishTest(test, usr);
		}
	}
	
	@Test(dataProvider = "LoginUsernameIncorrectAPI", dataProviderClass = Data.class, priority = 2)
	public void loginUsrIncorrectAPI(String usr, String pass) {
		ExtentTest test = report.createTest("Login Username Incorrect API Test");
		Response rs = null;

		startTest(test, usr);
		
		rs = loginAPI(test, usr, pass, LOGIN_API_INCORRECT_COMPLETED, rs);
		
		try {
			validateLoginIncorrectAPI(test, usr, pass, USR_DOES_NOT_EXIST_API, rs);

		} catch (AssertionError e) {
			handleAssertionError(test, usr, e);
			
		} finally {
			finishTest();
			
		}

	}
	
	@Test(dataProvider = "LoginPasswordIncorrectAPI", dataProviderClass = Data.class, priority = 3)
	public void loginPassIncorrectAPI(String usr, String pass) {
		ExtentTest test = report.createTest("Login Password Incorrect API Test");
		Response rs = null;
		
		startTest(test, usr);
		
		rs = loginIncorrectAPI(test, usr, pass, rs);

		try {
			validateLoginIncorrectAPI(test, usr, pass, WRONG_PASS_API, rs);

		} catch (AssertionError e) {
			handleAssertionError(test, usr, e);
			
		} finally {
			finishTest();
			
		}

	}
	
	// Test Post-Config
	@AfterMethod
	public void finishTest() {
		report.flush();
		
	}

}
